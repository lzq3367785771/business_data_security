APP_ENV=development

# =========================
# Platform Database
# =========================

DATABASE_URL=mysql+pymysql://bdas_user:YOUR_DB_PASSWORD@127.0.0.1:3306/business_data_security?charset=utf8mb4


# =========================
# JWT
# =========================

JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRE_MINUTES=60


# =========================
# Credential Encryption
# =========================

CREDENTIAL_MASTER_KEY=REPLACE_WITH_A_FERNET_KEY


# =========================
# Frontend
# =========================

FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173


# =========================
# Demo Accounts
# =========================

DEMO_ADMIN_PASSWORD=
DEMO_ANALYST_PASSWORD=